# Get your API key: https://ai.byteplus.com/ark/region:ap-southeast-1/apikey
ARK_API_KEY=
ARK_BASE_URL=https://ark.ap-southeast.bytepluses.com/api/v3


# --- Asset library (real people / virtual characters) ---
# IAM access keys with ArkFullAccess. Separate from ARK_API_KEY.
BYTEPLUS_AK=
BYTEPLUS_SK=
# BYTEPLUS_SESSION_TOKEN=        # only for temporary STS keys
ARK_PROJECT=default
# BYTEPLUS_REGION=ap-southeast-1
# ASSET_GROUP_ID=                # optional: preselect a group, e.g. your verified LivenessFace group
# ASSET_VERIFY_CALLBACK_URL=     # optional: where the liveness-check page redirects when done

# TOS bucket that hosts local uploads / marked frames (CreateAsset needs a public HTTPS URL)
TOS_BUCKET_NAME=
TOS_REGION=ap-southeast-1
# TOS_ENDPOINT=tos-ap-southeast-1.bytepluses.com
